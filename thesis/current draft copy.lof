\contentsline {figure}{\numberline {4.1}{\ignorespaces Proposed convolutional neural network architecture for direct sensorimotor decoding.}}{62}{figure.caption.44}%
\contentsline {figure}{\numberline {4.2}{\ignorespaces Dual-view silhouette samples from the stereo NeuroKin dataset.}}{67}{figure.caption.56}%
\contentsline {figure}{\numberline {4.3}{\ignorespaces MSE loss converging near zero during NeuroKin training.}}{71}{figure.caption.67}%
\contentsline {figure}{\numberline {4.4}{\ignorespaces NeuroKin output predictions on the validation set (ground truth vs. prediction).}}{73}{figure.caption.72}%
\contentsline {figure}{\numberline {4.5}{\ignorespaces Correlation between predicted and ground truth 3D end-effector positions for NeuroKin-3D.}}{75}{figure.caption.73}%
\addvspace {10\p@ }
\contentsline {figure}{\numberline {5.1}{\ignorespaces Standard closed-loop control flow integrating the self-model. The visual estimate overrides corrupted proprioceptive data when embodiment drift occurs.}}{82}{figure.caption.74}%
\contentsline {figure}{\numberline {5.2}{\ignorespaces Dynamic error recovery following actuator fault injection. The blind baseline controller diverges catastrophically, while NeuroKin's visual estimates enable rapid re-convergence to the target.}}{85}{figure.caption.76}%
\addvspace {10\p@ }
\contentsline {figure}{\numberline {6.1}{\ignorespaces Decentralized control loop enabling temporal coordination across sequential agents. Each agent reads the shared failure ledger, adapts its behavior accordingly, and writes its outcome back to the ledger for subsequent agents.}}{93}{figure.caption.78}%
\contentsline {figure}{\numberline {6.2}{\ignorespaces Algorithm Efficiency in Steps under injected faults. The IK baseline fails structurally (capped at 201 steps), while the NeuroKin swarm reads shared states and adapts behavior, maintaining efficiency between 20-40 steps.}}{99}{figure.caption.83}%
\addvspace {10\p@ }
\contentsline {figure}{\numberline {7.1}{\ignorespaces Pareto frontier illustrating the conceptual trade-off between model accuracy (PSNR) and computational cost. NeuroKin occupies a favorable region for control-oriented tasks that require rapid feedback.}}{107}{figure.caption.85}%
