\addvspace {10\p@ }
\contentsline {figure}{\numberline {1.1}{\ignorespaces Closed-loop self-modeling pipeline that connects perception, internal model update, and control.}}{3}{figure.caption.5}%
\contentsline {figure}{\numberline {1.2}{\ignorespaces Three eras of robot self-modeling: symbolic morphology inference via active exploration (Bongard et al., 2006), behavioral adaptation through repertoire search (Cully et al., 2015), and contemporary visual self-modeling driven by neural rendering (NeRF and 3D Gaussian Splatting).}}{3}{figure.caption.6}%
\contentsline {figure}{\numberline {1.3}{\ignorespaces Digital twin synchronization loop bridging sensing, simulation, and control.}}{9}{figure.caption.8}%
\addvspace {10\p@ }
\contentsline {figure}{\numberline {2.1}{\ignorespaces Taxonomy of self-modeling approaches across sensing modalities and modeling paradigms.}}{16}{figure.caption.9}%
\contentsline {figure}{\numberline {2.2}{\ignorespaces Speed-quality Pareto frontier for representative neural rendering methods.}}{20}{figure.caption.10}%
\addvspace {10\p@ }
\contentsline {figure}{\numberline {3.1}{\ignorespaces PyBullet simulation setup and fixed camera viewpoint for dataset generation.}}{37}{figure.caption.12}%
\contentsline {figure}{\numberline {3.2}{\ignorespaces Lorenz System Trajectory generating smooth, chaotic workspace exploration. The attractor produces deterministic non-repeating paths that densely cover the robot's configuration space.}}{40}{figure.caption.14}%
\contentsline {figure}{\numberline {3.3}{\ignorespaces End-to-end data generation and preprocessing pipeline. RGB images from PyBullet are converted to grayscale and thresholded to produce binary silhouettes for training.}}{41}{figure.caption.15}%
\contentsline {figure}{\numberline {3.4}{\ignorespaces Representative robot configurations from the dataset, demonstrating diverse poses including vertical extension, diagonal reach, and angled configurations.}}{42}{figure.caption.16}%
\contentsline {figure}{\numberline {3.5}{\ignorespaces FFKSM target versus render showing visual discrepancies. Volumetric rendering produces blurry depth predictions; errors concentrate at joint boundaries and link extremities where sampling density is insufficient.}}{50}{figure.caption.28}%
\contentsline {figure}{\numberline {3.6}{\ignorespaces K-3DGS render artifacts and spatial difference map. Isotropic spherical Gaussians create overlapping "blobby" artifacts that blur link boundaries.}}{56}{figure.caption.40}%
\contentsline {figure}{\numberline {3.7}{\ignorespaces K-3DGS training metrics showing loss convergence (top), FPS (middle), and step time (bottom). Inference speed stabilizes at 37 FPS after initial optimization.}}{57}{figure.caption.41}%
