\addvspace {10\p@ }
\contentsline {figure}{\numberline {1.2}{\ignorespaces Digital twin synchronization loop bridging sensing, simulation, and control.}}{4}{figure.caption.8}%
\addvspace {10\p@ }
\addvspace {10\p@ }
\contentsline {figure}{\numberline {3.1}{\ignorespaces NeuroKin convolutional decoder architecture. Joint-angle inputs are encoded into a latent representation, spatially expanded, and decoded through transposed convolution layers into a predicted visual self-model.}}{28}{figure.caption.27}%
\contentsline {figure}{\numberline {3.2}{\ignorespaces Dual-view data generation sample. Synchronized front and side camera silhouettes are concatenated to provide the stereoscopic evidence used by NeuroKin-3D.}}{33}{figure.caption.40}%
\contentsline {figure}{\numberline {3.3}{\ignorespaces Base NeuroKin qualitative validation results. Target silhouettes, NeuroKin renders, and difference maps show that direct decoding recovers link geometry with localized errors near joint boundaries and the end-effector.}}{37}{figure.caption.47}%
\contentsline {figure}{\numberline {3.4}{\ignorespaces NeuroKin-3D validation coordinates. Predicted $x$, $y$, and $z$ traces closely follow the ground-truth end-effector positions across the validation sequence.}}{38}{figure.caption.48}%
\addvspace {10\p@ }
\contentsline {figure}{\numberline {4.1}{\ignorespaces Closed-loop stereoscopic perception-control tracking loop topology.}}{42}{figure.caption.49}%
\contentsline {figure}{\numberline {4.2}{\ignorespaces Representative target-current end-effector error in 3D Cartesian space. The dashed segment visualizes the Euclidean distance minimized by the closed-loop reaching controller.}}{44}{figure.caption.50}%
\contentsline {figure}{\numberline {4.3}{\ignorespaces Baseline error convergence over time steps. Both NeuroKin and pure proprioceptive controllers converge smoothly to sub-centimeter error within 50 steps under nominal conditions. The shaded region indicates $\pm 1$ standard deviation across 100 trials.}}{47}{figure.caption.52}%
\contentsline {figure}{\numberline {4.4}{\ignorespaces Representative closed-loop end-effector trajectory from start position to target position. The smooth path confirms that the visual state estimate supports stable task-space motion.}}{48}{figure.caption.53}%
\contentsline {figure}{\numberline {4.5}{\ignorespaces Dynamic error recovery following encoder slip injected at Step 50. The baseline pure proprioceptive controller diverges catastrophically, while NeuroKin's visual estimates enable rapid re-convergence to the target.}}{49}{figure.caption.54}%
\contentsline {figure}{\numberline {4.6}{\ignorespaces Closed-loop joint-angle error over time. All four joint estimates converge toward zero, supporting the use of NeuroKin-3D joint outputs in the Jacobian feedback loop.}}{51}{figure.caption.56}%
\addvspace {10\p@ }
\contentsline {figure}{\numberline {5.1}{\ignorespaces Temporal stigmergy execution block passing discrete environmental updates over time.}}{60}{figure.caption.62}%
\contentsline {figure}{\numberline {5.2}{\ignorespaces Algorithm Efficiency in Steps under injected faults. The IK baseline fails structurally (capped at 201 steps), while the NeuroKin swarm reads shared states and adapts behavior, maintaining efficiency between 20-40 steps.}}{62}{figure.caption.64}%
\addvspace {10\p@ }
\contentsline {figure}{\numberline {6.1}{\ignorespaces Pareto frontier illustrating the optimal trade-off between model accuracy (PSNR) and computational speed (FPS). NeuroKin occupies the upper-right region, achieving both superior quality and sub-millisecond latency. The red dashed line indicates the 1,000 FPS threshold for 1 kHz control loops.}}{66}{figure.caption.65}%
